# Ignore macOS system files
.DS_Store

# Ignore node modules and build artifacts
node_modules/
build/
export/

# Keep package.json and package-lock.json in version control

# Ignore environment files and common local secret-bearing files
.env
.env.*
!.env.example
.npmrc
*.pem
*.p12
*.pfx
*.key
*.crt
*.cer

# Ignore Claude Desktop configuration files
./claude-desktop-config.json

# Ignore logs
*.log
build/*.log

# Ignore temporary files
*.tmp
tmp/
temp/

# Ignore IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Ignore coverage reports
coverage/
.nyc_output/
*.lcov
.coverage
htmlcov/
coverage.xml
coverage.json
.jest/
junit.xml

# Ignore MCPB files
*.mcpb
